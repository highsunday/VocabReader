{
  "name": "@reader/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "A Codex-powered EPUB language-learning reader.",
  "author": "highsunday",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c blue,green \"vite --host 127.0.0.1\" \"npm run dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && npm run build:main && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:main && vite build",
    "build:main": "esbuild src/main/main.ts src/preload/preload.ts --bundle --platform=node --format=cjs --outdir=dist-electron --entry-names=[name] --out-extension:.js=.cjs --external:electron --external:sharp --loader:.md=text --loader:.png=file --asset-names=assets/[name]-[hash]",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:release": "node --test tests/release-config.test.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "dist:mac:x64": "npm run build && electron-builder --mac dmg --x64 --publish never",
    "dist:win:x64": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.highsunday.vocabreader",
    "productName": "VocabReader",
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "npmRebuild": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon/vocabreader-language-learning-v6.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "win": {
      "icon": "assets/icon/vocabreader-language-learning-v6.png",
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "VocabReader"
    },
    "publish": {
      "provider": "github",
      "owner": "highsunday",
      "repo": "VocabReader"
    }
  }
}
